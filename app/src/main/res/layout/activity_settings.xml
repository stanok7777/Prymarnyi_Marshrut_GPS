<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:src="@android:drawable/ic_menu_revert" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Налаштування"
            android:textColor="#000"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Блок: Офлайн-пошук адрес -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Офлайн-пошук адрес"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#333"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Пошук вулиць, будинків, населених пунктів без інтернету за каталогом OpenStreetMap. Каталоги по областях."
                android:textSize="14sp" />
            
            <Button
                android:id="@+id/btnDownloadAll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="#E0E0E0"
                android:textColor="#000"
                android:text="Завантажити всі області (36,2 МБ)" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Усі області (25, встановлено 2)"
                android:textStyle="bold" />
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FFF"
                android:padding="12dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="✓ Дніпропетровська область
версія 2026-09-21, 6.8 МБ"
                    android:textColor="#000" />
                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Видалити"
                    android:backgroundTint="#FFEBEE"
                    android:textColor="#D32F2F" />
            </LinearLayout>

            <Button
                android:id="@+id/btnUpdateCatalogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#E0E0E0"
                android:textColor="#000"
                android:text="Оновити список каталогів" />

            <!-- Блок: Кешування карти -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Кешування карти (Офлайн)"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#333"/>
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FFF"
                android:padding="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Кешувати карту вздовж маршруту"
                        android:textColor="#000"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Підвантажується смуга ±1.2 км вздовж маршруту. Потрібен інтернет."
                        android:textSize="12sp" />
                </LinearLayout>
                <Switch android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
            </LinearLayout>

            <!-- Блок: Аналітика та Навігація -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Ведення та Аналітика"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#333"/>
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FFF"
                android:padding="16dp"
                android:text="Налаштування голосу, камер фіксації, поведінка без GPS та розрахунок особистого коефіцієнту заторів."
                android:textColor="#000" />
                
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FFF"
                android:padding="16dp"
                android:text="Світлофори, переходи, переїзди (База OSM по всій Україні)"
                android:textColor="#000" />
                
        </LinearLayout>
    </ScrollView>
</LinearLayout>